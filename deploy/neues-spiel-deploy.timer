# Auto-Deploy-Takt. Kopieren nach /etc/systemd/system/neues-spiel-deploy.timer
#
# Fragt alle ~15 Sekunden, ob es neue Commits gibt. Ohne neue Commits macht
# der Lauf nichts (kein Rebuild, kein Neustart) — ein git fetch ist winzig.
# AccuracySec=2s ist noetig, sonst buendelt systemd den Takt auf bis zu 1 min.

[Unit]
Description=Prueft alle 15s auf neue Commits und deployt sie

[Timer]
OnBootSec=15s
OnUnitActiveSec=15s
AccuracySec=2s
Unit=neues-spiel-deploy.service

[Install]
WantedBy=timers.target
